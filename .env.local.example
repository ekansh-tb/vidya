# Vidya environment template
# Copy this file to .env.local and fill only the services you use.
# Never commit .env.local or any real credential.

# Clerk parent authentication
# Create these in the Clerk dashboard under API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Neon Postgres
# Server APIs use the pooled URL. The migration script prefers the unpooled URL.
DATABASE_URL=postgresql://...
DATABASE_URL_UNPOOLED=postgresql://...

# Optional operator-funded AI fallback
# Parent-owned connections entered in the dashboard do not belong here.
# Vercel deployments can use AI_GATEWAY_API_KEY or managed VERCEL_OIDC_TOKEN.
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=

# Parent AI credential vault
# Generate a 32-byte base64 key with: openssl rand -base64 32
# Keep the current key version stable until performing a planned rotation.
AI_CREDENTIAL_ENCRYPTION_KEY=
AI_CREDENTIAL_ENCRYPTION_KEY_VERSION=v1

# Optional JSON map of old version names to old base64 keys during rotation.
# Example: {"v0":"base64-key-from-the-previous-version"}
AI_CREDENTIAL_DECRYPTION_KEYS=

# Exact public origin used for the OpenRouter OAuth callback.
# Production must use HTTPS. Local development can use this HTTP origin.
AI_OAUTH_CALLBACK_ORIGIN=http://localhost:3000
