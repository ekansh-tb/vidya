# Vidya Quest — environment template
# Copy to .env.local and fill in. Never commit .env.local.

# ── Supabase ──────────────────────────────────────────────────────
# From your Supabase project → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Service-role key — server-only, NEVER exposed to the client.
# Used by API routes that must bypass RLS (rare; only for admin tasks).
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ── Anthropic (existing) ──────────────────────────────────────────
ANTHROPIC_API_KEY=<your-anthropic-key>

# ── Future BYOK passthrough (per-parent, encrypted in DB) ─────────
# Parents bring their own keys via the Parent Dashboard; no .env entry.
