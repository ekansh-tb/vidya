# Vidya Quest — environment template
# Copy to .env.local and fill in. Never commit .env.local.

# ── Supabase ──────────────────────────────────────────────────────
# From your Supabase project → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
# 2025+ naming: "publishable key" replaces "anon key".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# 2025+ naming: "secret key" replaces "service_role key".
# Server-only. NEVER expose to the client. Needed only for API routes
# that must bypass RLS (admin tasks). Optional for normal parent auth.
SUPABASE_SECRET_KEY=sb_secret_...

# ── Anthropic (existing) ──────────────────────────────────────────
ANTHROPIC_API_KEY=<your-anthropic-key>

# ── Future BYOK passthrough (per-parent, encrypted in DB) ─────────
# Parents bring their own keys via the Parent Dashboard; no .env entry.
