# Vidya — environment template
# Copy to .env.local and fill in. Never commit .env.local.

# ── Clerk (parent auth) ───────────────────────────────────────────
# From your Clerk dashboard → API Keys.
# Without these, Clerk runs in "keyless" dev mode and writes a temporary
# key into .clerk/ — fine for local poking, never for a real deploy.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ── Anthropic (Miss Vidya tutor + daily assembly) ─────────────────
# On Vercel, prefer the AI Gateway (AI_GATEWAY_API_KEY or the OIDC
# token) over a raw provider key. The API routes accept any of the
# three and fall back to offline content when none is set.
ANTHROPIC_API_KEY=<your-anthropic-key>

# ── Notes ─────────────────────────────────────────────────────────
# There is no database. Learner state lives in the browser's
# localStorage under `vidya-quest:profiles:v2`. Supabase was scrapped
# on 2026-05-21 before any migration ran — see docs/AUTH_ARCHITECTURE.md
# for the forward-looking schema if a server DB is ever reintroduced.
#
# Future BYOK passthrough (per-parent, encrypted at rest) is a rung-3
# feature and will not use .env — parents supply keys in the dashboard.
